# ==============================================================================
# Apify Multi-Key Pool & Google Maps Scraper Configuration
# ==============================================================================

# Apify API Tokens (Multi-Key Pool)
# You can supply multiple tokens separated by commas.
# The system automatically tracks balances, rotates keys on quota exhaustion,
# and switches to the next healthy account seamlessly.
APIFY_TOKENS=apify_api_token1,apify_api_token2,apify_api_token3

# Single Token Fallback (Optional, for backward compatibility)
APIFY_TOKEN=your_apify_api_token_here

# Key Rotation Strategy: 'sequential' (use current key until exhausted, then rotate)
# or 'highest_balance' (always prioritize key with highest remaining USD balance)
KEY_ROTATION_STRATEGY=sequential

# ------------------------------------------------------------------------------
# Paths Configuration (Optional - Defaults to data/ directory)
# ------------------------------------------------------------------------------
# Source database containing input cafes with coordinates (table: cafes_cafe)
# Default: data/cafes_cafe_shard00.db (or your local crawler shard in data/)
# SOURCE_DB_PATH=data/cafes_cafe_shard00.db

# Output clean relational SQLite database
# Default: data/google_maps.db
# OUTPUT_DB_PATH=data/google_maps.db

# Raw JSON Lines archive for zero data loss
# Default: data/google_maps_raw.jsonl
# RAW_JSONL_PATH=data/google_maps_raw.jsonl

# Directory where downloaded cafe photos will be stored
# Default: data/downloaded_images
# IMAGES_DIR=data/downloaded_images

# ------------------------------------------------------------------------------
# Crawler Tuning & Concurrency (Optional)
# ------------------------------------------------------------------------------
# Number of cafes to batch per Apify crawler run (default: 50)
# BATCH_SIZE=50

# Maximum photos to request per place (default: 50)
# MAX_IMAGES_PER_PLACE=50

# Maximum reviews to request per place (default: 15)
# MAX_REVIEWS_PER_PLACE=15

# Extract image author names to distinguish owner vs visitor photos (default: true)
# SCRAPE_IMAGE_AUTHORS=true

# Download only owner & official cover photos, excluding visitor review junk (default: true)
# DOWNLOAD_ONLY_OWNER=true

# Google Maps viewport zoom level for coordinate-targeted search (default: 17)
# ZOOM_LEVEL=17

# Number of candidate places to extract per search URL (default: 5)
# Evaluates top-5 results with strict distance decay & cross-lingual name matching
# MAX_PLACES_PER_SEARCH=5

# Strict composite match threshold between 0.0 and 1.0 (default: 0.80)
# Places with composite score below this threshold are marked as not_found
# MATCH_THRESHOLD=0.80

# Number of retry attempts on Apify failure (default: 2)
# MAX_RETRIES=2

# Concurrency level for parallel photo downloads (default: 25)
# MAX_IMAGE_WORKERS=25
