# ==============================================================================
# Apify & Google Maps Scraper Configuration
# ==============================================================================

# Apify API Token (Required)
# Get your token from: https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_api_token_here

# ------------------------------------------------------------------------------
# Paths Configuration (Optional)
# ------------------------------------------------------------------------------
# Source database containing input cafes with coordinates (table: cafes_cafe)
# Default: cafes_cafe_shard00.db (or your local crawler shard)
# SOURCE_DB_PATH=cafes_cafe_shard00.db

# Output database to store scraped raw Google Places data
# Default: google_maps_raw.db
# OUTPUT_DB_PATH=google_maps_raw.db

# Directory where downloaded cafe photos will be stored
# Default: downloaded_images
# IMAGES_DIR=downloaded_images

# ------------------------------------------------------------------------------
# Crawler Tuning & Concurrency (Optional)
# ------------------------------------------------------------------------------
# Number of cafes to batch per Apify crawler run (default: 50)
# BATCH_SIZE=50

# Maximum photos to request per place (default: 50)
# MAX_IMAGES_PER_PLACE=50

# Maximum reviews to request per place (default: 15)
# MAX_REVIEWS_PER_PLACE=15

# Google Maps viewport zoom level for coordinate-targeted search (default: 17)
# ZOOM_LEVEL=17

# Number of retry attempts on Apify failure (default: 2)
# MAX_RETRIES=2

# Concurrency level for parallel photo downloads (default: 25)
# MAX_IMAGE_WORKERS=25
